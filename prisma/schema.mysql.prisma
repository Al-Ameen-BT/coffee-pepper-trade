generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Party {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  role      PartyRole
  place     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lots      Lot[]
  payments  Payment[]
  loans     Loan[]
  invoices  Invoice[]
}

model Item {
  id       String @id @default(cuid())
  name     String @unique
  slug     String @unique
  hsnCode  String @default("")
  cgstRate Float  @default(0)
  lots     Lot[]
  loans    Loan[]
}

/// One invoice = one payment. Header for a multi-line Bill of Supply.
model Invoice {
  id            String   @id @default(cuid())
  billNo        String   @unique
  date          DateTime
  kind          TradeType
  partyId       String
  party         Party    @relation(fields: [partyId], references: [id])
  subtotal      Float
  taxableValue  Float
  cgstAmount    Float    @default(0)
  sgstAmount    Float    @default(0)
  tcsAmount     Float    @default(0)
  tdsAmount     Float    @default(0)
  roundOff      Float    @default(0)
  total         Float
  placeOfSupply String?
  notes         String?
  paymentId     String?  @unique
  payment       Payment? @relation(fields: [paymentId], references: [id])
  lines         InvoiceLine[]
  createdAt     DateTime @default(now())

  @@index([partyId])
  @@index([date])
}

/// Invoice line — each line keeps its link to the Fixing that priced the lot.
model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fixingId    String?  @unique
  fixing      Fixing?  @relation(fields: [fixingId], references: [id])
  description String
  hsnCode     String
  kg          Float
  rate        Float
  amount      Float
  cgstRate    Float   @default(0)
  cgstAmount  Float   @default(0)
  sgstRate    Float   @default(0)
  sgstAmount  Float   @default(0)
  lotNo       String?

  @@index([invoiceId])
  @@index([fixingId])
}

model Fund {
  id            String          @id @default(cuid())
  name          String
  type          FundType
  opening       Float           @default(0)
  bankName      String?
  accountNumber String?
  createdAt     DateTime        @default(now())
  payments      Payment[]
  loans         Loan[]
  repayments    LoanRepayment[]
  otherTransactions OtherTransaction[]
}

model Lot {
  id                String   @id @default(cuid())
  kind              LotKind
  partyId           String
  party             Party    @relation(fields: [partyId], references: [id])
  itemId            String
  item              Item     @relation(fields: [itemId], references: [id])
  date              DateTime
  grossWeightKg     Float?
  bagCount          Int?
  bagTareKg         Float?
  moisturePercent   Float?
  driageDeductionKg Float?
  totalKg           Float
  notes             String?
  billNo            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  fixings           Fixing[]

  @@index([partyId])
  @@index([itemId])
  @@index([date])
}

model Fixing {
  id        String   @id @default(cuid())
  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id])
  date      DateTime
  kg        Float
  rate      Float
  tcsRate   Float?
  tcsAmount Float?
  tdsRate   Float?
  tdsAmount Float?
  billNo    String?  @unique
  notes     String?
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  invoiceLine InvoiceLine?
  createdAt DateTime @default(now())

  @@index([lotId])
  @@index([paymentId])
}

model Payment {
  id              String              @id @default(cuid())
  partyId         String
  party           Party               @relation(fields: [partyId], references: [id])
  date            DateTime
  amount          Float
  advanceDeducted Float?              @default(0)
  grossAmount     Float?
  direction       Direction
  tradeType       TradeType
  fundId          String
  fund            Fund                @relation(fields: [fundId], references: [id])
  billNo          String              @unique
  itemId          String?
  priceKg         Float?
  rate            Float?
  method          String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  adjustments     AdvanceAdjustment[]
  billedFixings   Fixing[]
  invoice         Invoice?

  @@index([partyId])
  @@index([fundId])
  @@index([date])
}

model Loan {
  id            String              @id @default(cuid())
  partyId       String
  party         Party               @relation(fields: [partyId], references: [id])
  date          DateTime
  amount        Float
  balanceAmount Float               @default(0)
  status        LoanStatus          @default(ACTIVE)
  kind          LoanKind
  fundId        String
  fund          Fund                @relation(fields: [fundId], references: [id])
  itemId        String?
  item          Item?               @relation(fields: [itemId], references: [id])
  method        String?
  purpose       String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  adjustments   AdvanceAdjustment[]
  repayments    LoanRepayment[]

  @@index([partyId])
  @@index([fundId])
}

model AdvanceAdjustment {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([loanId])
}

model LoanRepayment {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  fundId    String
  fund      Fund     @relation(fields: [fundId], references: [id])
  amount    Float
  date      DateTime
  method    String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([loanId])
  @@index([fundId])
}

enum Role {
  USER
  ADMIN
}

enum PartyRole {
  SUPPLIER
  BUYER
  BOTH
}

enum FundType {
  CASH
  CURRENT
  CC
}

enum LotKind {
  PURCHASE
  SALE
}

enum Direction {
  PAY
  RECEIVE
}

enum TradeType {
  PURCHASE
  SALE
}

enum LoanKind {
  LOAN_GIVEN
  LOAN_TAKEN
  ADVANCE_GIVEN
  ADVANCE_TAKEN
}

enum LoanStatus {
  ACTIVE
  PARTIALLY_SETTLED
  SETTLED
}

model BillSequence {
  id            String @id @default(cuid())
  prefix        String
  financialYear String
  lastNumber    Int    @default(0)
  
  @@unique([prefix, financialYear])
}

model OtherTransaction {
  id          String         @id @default(cuid())
  type        OtherTxnType
  category    String
  amount      Decimal
  fundId      String
  fund        Fund           @relation(fields: [fundId], references: [id])
  date        DateTime
  billNo      String?
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  @@index([fundId])
  @@index([date])
}

model CompanyInfo {
  id          String  @id @default(cuid())
  name        String
  tagline     String
  gstin       String
  address     String
  state       String
  stateCode   String
  phone       String
  bankName    String?
  bankAccount String?
  bankIfsc    String?
}

enum OtherTxnType {
  EXPENSE
  INCOME
}
