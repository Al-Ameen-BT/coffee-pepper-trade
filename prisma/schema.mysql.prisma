generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Party {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  role      PartyRole
  place     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lots      Lot[]
  payments  Payment[]
  loans     Loan[]
}

model Item {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  lots  Lot[]
  loans Loan[]
}

model Fund {
  id            String          @id @default(cuid())
  name          String
  type          FundType
  opening       Decimal         @db.Decimal(14, 2) @default(0)
  bankName      String?
  accountNumber String?
  createdAt     DateTime        @default(now())
  payments      Payment[]
  loans         Loan[]
  repayments    LoanRepayment[]
}

model Lot {
  id                String   @id @default(cuid())
  kind              LotKind
  partyId           String
  party             Party    @relation(fields: [partyId], references: [id])
  itemId            String
  item              Item     @relation(fields: [itemId], references: [id])
  date              DateTime @db.Date
  grossWeightKg     Decimal? @db.Decimal(12, 3)
  bagCount          Int?
  bagTareKg         Decimal? @db.Decimal(12, 3)
  moisturePercent   Decimal? @db.Decimal(5, 2)
  driageDeductionKg Decimal? @db.Decimal(12, 3)
  totalKg           Decimal  @db.Decimal(12, 3)
  notes             String?
  billNo            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  fixings           Fixing[]

  @@index([partyId])
  @@index([itemId])
  @@index([date])
}

model Fixing {
  id        String   @id @default(cuid())
  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id])
  date      DateTime @db.Date
  kg        Decimal  @db.Decimal(12, 3)
  rate      Decimal  @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now())

  @@index([lotId])
}

model Payment {
  id              String              @id @default(cuid())
  partyId         String
  party           Party               @relation(fields: [partyId], references: [id])
  date            DateTime            @db.Date
  amount          Decimal             @db.Decimal(14, 2)
  advanceDeducted Decimal?            @db.Decimal(14, 2) @default(0)
  grossAmount     Decimal?            @db.Decimal(14, 2)
  direction       Direction
  tradeType       TradeType
  fundId          String
  fund            Fund                @relation(fields: [fundId], references: [id])
  billNo          String              @unique
  itemId          String?
  priceKg         Decimal?            @db.Decimal(12, 3)
  rate            Decimal?            @db.Decimal(12, 2)
  method          String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  adjustments     AdvanceAdjustment[]

  @@index([partyId])
  @@index([fundId])
  @@index([date])
}

model Loan {
  id            String              @id @default(cuid())
  partyId       String
  party         Party               @relation(fields: [partyId], references: [id])
  date          DateTime            @db.Date
  amount        Decimal             @db.Decimal(14, 2)
  balanceAmount Decimal             @db.Decimal(14, 2) @default(0)
  status        LoanStatus          @default(ACTIVE)
  kind          LoanKind
  fundId        String
  fund          Fund                @relation(fields: [fundId], references: [id])
  itemId        String?
  item          Item?               @relation(fields: [itemId], references: [id])
  method        String?
  purpose       String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  adjustments   AdvanceAdjustment[]
  repayments    LoanRepayment[]

  @@index([partyId])
  @@index([fundId])
}

model AdvanceAdjustment {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @db.Date
  notes     String?
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([loanId])
}

model LoanRepayment {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  fundId    String
  fund      Fund     @relation(fields: [fundId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @db.Date
  method    String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([loanId])
  @@index([fundId])
}

enum Role {
  USER
  ADMIN
}

enum PartyRole {
  SUPPLIER
  BUYER
  BOTH
}

enum FundType {
  CASH
  CURRENT
  CC
}

enum LotKind {
  PURCHASE
  SALE
}

enum Direction {
  PAY
  RECEIVE
}

enum TradeType {
  PURCHASE
  SALE
}

enum LoanKind {
  LOAN_GIVEN
  LOAN_TAKEN
  ADVANCE_GIVEN
  ADVANCE_TAKEN
}

enum LoanStatus {
  ACTIVE
  PARTIALLY_SETTLED
  SETTLED
}
