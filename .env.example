# ─── Database ─────────────────────────────────────────────────────────────────
DB_PROVIDER="mysql"
DATABASE_URL="mysql://root:password@localhost:3306/uzhunnungal_traders"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Authentication & Encryption ─────────────────────────────────────────────
# CRITICAL: Generate strong secrets for production using: openssl rand -hex 32
JWT_SECRET=change-this-to-a-64-char-random-hex-string-use-openssl-rand
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=change-this-to-a-64-char-random-hex-for-aes256-encryption

# ─── HTTPS / Security ────────────────────────────────────────────────────────
# Set to true in production behind Nginx with TLS certificates
FORCE_HTTPS=false

# ─── Client URL ──────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
