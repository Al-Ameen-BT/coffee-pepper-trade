# ─── Production Environment Configuration ─────────────────────────────────────
# Uzhunnungal Traders — Internal Trading System
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PROVIDER="mysql"
DATABASE_URL="mysql://uzhunnungal:STRONG_PASSWORD@127.0.0.1:3306/uzhunnungal_traders"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_FROM_OPENSSL_RAND
JWT_EXPIRES_IN=1d

# ─── Encryption (AES-256-GCM for bank account numbers) ───────────────────────
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_HEX_FROM_OPENSSL_RAND

# ─── HTTPS Enforcement ───────────────────────────────────────────────────────
# Defense in depth for any request that reaches Express without HTTPS
FORCE_HTTPS=true

# ─── Public client URL (the ngrok HTTPS origin, or direct IP with :3424) ─────
CLIENT_URL=https://your-assigned-ngrok-host.ngrok-free.app
