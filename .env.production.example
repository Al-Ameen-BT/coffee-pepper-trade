# Production Database (SQLite file - zero RAM overhead, ideal for 1GB RAM)
DB_PROVIDER="sqlite"
DATABASE_URL="file:./prisma/prod.db"

# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Authentication
# Generate a strong 64-char key using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Public URL (Your domain name e.g. https://ledger.yourdomain.com or http://<EC2-IP>)
CLIENT_URL=http://your-ec2-ip-or-domain
